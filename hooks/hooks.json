{
  "description": "Route clear, self-contained prompts to a lower-cost Codex subagent.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/route.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\route.js\"",
            "timeout": 6,
            "statusMessage": "Choosing an efficient agent",
            "additionalContextLimit": 300
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/observe-subagent.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\observe-subagent.js\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/observe-subagent.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\observe-subagent.js\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
